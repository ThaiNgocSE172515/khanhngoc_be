// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum JobStatus {
  open
  closed
}

model Job {
  job_id             String   @id @default(uuid()) @db.Uuid
  title              String
  titleEn            String?
  locations          String
  locationsEn        String?
  quantity           String
  quantityEn         String?
  salary             String
  salaryEn           String?
  level              String
  levelEn            String?
  experience         String
  experienceEn       String?
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt
  descriptionHtml    String
  descriptionHtmlEn  String?
  requirementsHtml   String
  requirementsHtmlEn String?
  benefitsHtml       String
  benefitsHtmlEn     String?

  @@index([created_at(sort: Desc)])
  @@map("jobs")
}

model Applications {
  id            String   @id @default(uuid()) @db.Uuid
  fullName      String
  phone         String
  email         String
  address       String
  instroduction String
  status        String
  cvUrl         String?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  @@index([status])
  @@index([created_at(sort: Desc)])
  @@map("applications")
}

model Project {
  id               String   @id @default(uuid()) @db.Uuid
  name             String
  nameEn           String?
  investor         String
  investorEn       String?
  projectType      String
  projectTypeEn    String?
  completionTime   String
  completionTimeEn String?
  location         String
  locationEn       String?
  description      String
  descriptionEn    String?
  area             String
  areaEn           String?
  mainImages       String[]
  images           String[]
  revitLink        String?
  lat              String?
  lng              String?
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  @@index([projectType])
  @@index([investor])
  @@index([completionTime])
  @@index([created_at(sort: Desc)])
  @@map("projects")
}

model Member {
  id         String   @id @default(uuid()) @db.Uuid
  name       String
  nameEn     String?
  position   String
  positionEn String?
  story      String
  storyEn    String?
  image      String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([created_at(sort: Desc)])
  @@map("members")
}

enum Role {
  USER
  ADMIN
}

model User {
  id        String   @id // Nhận trực tiếp UUID từ Supabase Auth
  email     String   @unique
  fullName  String?
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@map("users")
}

enum ContactType {
  CONTACT
  PROFILE
}

model Contact {
  id          String      @id @default(uuid()) @db.Uuid
  type        ContactType @default(CONTACT)
  name        String
  phone       String
  email       String
  address     String?
  message     String?

  company     String?
  mst         String?
  field       String?
  strength    String?
  revenuePrev String?
  revenuePlan String?
  link        String?
  note        String?

  status      String      @default("pending")
  created_at  DateTime    @default(now())
  updated_at  DateTime    @updatedAt

  @@index([type])
  @@index([status])
  @@index([created_at(sort: Desc)])
  @@map("contacts")
}

model AppRelease {
  id           String   @id @default(uuid())
  name         String
  version      String?
  platform     String?  // VD: Windows, Android, macOS, Linux
  description  String?
  iconUrl      String?  // Hình ảnh ứng dụng - có thể để trống
  fileUrl      String   // Link tải file ứng dụng trên R2
  fileKey      String   // Object key trên R2 để xóa/thay thế khi cần
  fileName     String   // Tên file gốc
  fileSize     BigInt   // Dung lượng (bytes), hỗ trợ file lớn >= 50MB
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("app_releases")
}