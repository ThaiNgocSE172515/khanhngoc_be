// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum JobStatus {
  open
  closed
}

model Job {
  job_id           String   @id @default(uuid()) @db.Uuid
  title            String
  locations        String
  quantity         String
  salary           String
  level            String
  experience       String
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt
  descriptionHtml  String
  requirementsHtml String
  benefitsHtml     String

  @@index([created_at(sort: Desc)])
  @@map("jobs")
}

model Applications {
  id            String   @id @default(uuid()) @db.Uuid
  fullName      String
  phone         String
  email         String
  address       String
  instroduction String
  status        String
  cvUrl         String?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  @@index([status])
  @@index([created_at(sort: Desc)])
  @@map("applications")
}

model Project {
  id             String   @id @default(uuid()) @db.Uuid
  name           String
  investor       String
  projectType    String
  completionTime String
  location       String
  description    String
  area           String
  mainImages     String[]
  images         String[]
  revitLink      String?
  lat            String? 
  lng            String?
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  @@index([projectType])
  @@index([investor])
  @@index([completionTime])
  @@index([created_at(sort: Desc)])
  @@map("projects")
}

model Member {
  id         String   @id @default(uuid()) @db.Uuid
  name       String
  position   String
  story      String
  image      String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([created_at(sort: Desc)])
  @@map("members")
}

enum Role {
  USER
  ADMIN
}

model User {
  id        String   @id // Nhận trực tiếp UUID từ Supabase Auth
  email     String   @unique
  fullName  String?
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@map("users")
}
