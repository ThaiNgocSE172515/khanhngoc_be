generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum JobStatus {
  open
  closed
}

model Job {
  job_id           String   @id @default(uuid()) @db.Uuid
  title            String
  locations        String
  quantity         String
  salary           String
  level            String
  experience       String
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt
  descriptionHtml  String
  requirementsHtml String
  benefitsHtml     String

  @@map("jobs")
}

model Applications {
  id            String   @id @default(uuid()) @db.Uuid
  fullName      String
  phone         String
  email         String
  address       String
  instroduction String
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
}
